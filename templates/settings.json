{
  "claudeHarnessRemove": {
    "permissions.deny": [
      "Read(//**/*.pem)",
      "Read(//**/*.key)"
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:main)",
      "Bash(git push *:master)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/master)",
      "Bash(git reset --hard origin/*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/**/*.pem)",
      "Read(~/**/*.key)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Bash(git branch -d main)",
      "Bash(git branch -D main)",
      "Bash(git branch --delete main)",
      "Bash(git branch -d master)",
      "Bash(git branch -D master)",
      "Bash(git branch --delete master)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "gh pr *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.yarnpkg.com",
        "registry.npmjs.org"
      ]
    },
    "failIfUnavailable": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-harness/block-dangerous.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-harness/stop-verify.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
